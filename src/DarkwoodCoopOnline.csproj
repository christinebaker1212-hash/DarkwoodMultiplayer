<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>DarkwoodCoopOnline</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>11.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <RootNamespace />
    <Nullable>disable</Nullable>
    <NoWarn>CS0618;CS0649;CS0169;CS0414;CS0162;CS8981</NoWarn>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DisableImplicitFrameworkReferences>false</DisableImplicitFrameworkReferences>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="DarkwoodCoopOnline.assets.HOST.png" LogicalName="DarkwoodCoopOnline.assets.HOST.png" />
    <EmbeddedResource Include="DarkwoodCoopOnline.assets.JOIN.png" LogicalName="DarkwoodCoopOnline.assets.JOIN.png" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>../lib/bepinex/BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>../lib/bepinex/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>../lib/stubs/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Rewired_Core"><HintPath>../lib/stubs/Rewired_Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="com.rlabrecque.steamworks.net"><HintPath>../lib/stubs/com.rlabrecque.steamworks.net.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>../lib/newtonsoft/Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Core" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="../lib/unity/*.dll"><Private>false</Private></Reference>
  </ItemGroup>
</Project>
